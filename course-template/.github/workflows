name: Byg og Udgiv LaTeX PDF'er

on: [push, workflow_dispatch]

permissions:
  contents: write
  pages: write
  id-token: write

jobs:
  build_latex:
    runs-on: ubuntu-latest

    steps:
      - name: Checkout kode
        uses: actions/checkout@v4
        with:
          fetch-depth: 0

      # ✅ Kompiler alle .tex filer i rod-mappen
      - name: Kompiler LaTeX dokumenter
        uses: xu-cheng/latex-action@v3
        with:
          root_file: "*.tex"
          args: "-pdfxe -interaction=nonstopmode -halt-on-error"

      # ✅ Forbered indhold til GitHub Pages
      - name: Forbered hjemmeside
        run: |
          mkdir -p /tmp/site
          # Kopier alle dannede PDF'er
          cp *.pdf /tmp/site/ || true

          # Lav en pæn dansk index.html
          echo "<html><head><title>PDF Oversigt</title><meta charset='UTF-8'></head><body>" > /tmp/site/index.html
          echo "<h1>📄 Tilgængelige PDF-dokumenter</h1><hr><ul>" >> /tmp/site/index.html
          
          for f in /tmp/site/*.pdf; do
            [ -e "$f" ] || continue
            filename=$(basename "$f")
            echo "<li><a href=\"$filename\" target=\"_blank\">$filename</a></li>" >> /tmp/site/index.html
          done
          
          echo "</ul><p><i>Sidst opdateret: $(date +'%d/%m-%Y %H:%M')</i></p></body></html>" >> /tmp/site/index.html

      # ✅ Udgiv til gh-pages branchen
      - name: Udgiv til GitHub Pages
        uses: peaceiris/actions-gh-pages@v4
        with:
          github_token: ${{ secrets.GITHUB_TOKEN }}
          publish_branch: gh-pages
          publish_dir: /tmp/site
          force_orphan: true

      # ✅ Opdater README på main-branchen med direkte links
      - name: Opdater README
        run: |
          git config --global user.name "github-actions[bot]"
          git config --global user.email "github-actions[bot]@users.noreply.github.com"
          
          # Hent nyeste main
          git checkout main
          
          # Fjern gammel sektion hvis den findes, og indsæt en frisk
          sed -i '/## 📄 Tilgængelige PDF/,$d' README.md
          
          echo -e "\n## 📄 Tilgængelige PDF'er (Auto-genereret)" >> README.md
          echo "Se alle dokumenter her: [${{ github.repository_owner }}.github.io/${{ github.event.repository.name }}](https://${{ github.repository_owner }}.github.io/${{ github.event.repository.name }}/)" >> README.md
          echo "" >> README.md
          
          for f in *.pdf; do
            [ -e "$f" ] || continue
            name=$(basename "$f")
            URL="https://${{ github.repository_owner }}.github.io/${{ github.event.repository.name }}/$name"
            echo "- [$name]($URL)" >> README.md
          done

          git add README.md
          git commit -m "chore: opdater README med PDF links [skip ci]" || echo "Ingen ændringer"
          git push origin main
